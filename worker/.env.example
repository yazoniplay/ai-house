# Local-only secrets. Copy to worker/.env; never commit real values.
SUPABASE_URL=https://ccdykioxztegxonuyvwb.supabase.co
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
TOKEN_HARBOR_KEY=
TOKEN_HARBOR_MODEL=deepseek-v4.1-flash:free
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3.1-pro
OLLAMA_API_KEY=
# Tavily is required for fresh search when Gemini is unavailable.
TAVILY_API_KEY=
GROQ_API_KEY=
# Main model: CEO and specialist fallback reasoning.
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: task summaries and quick review triage.
GROQ_FAST_MODEL=openai/gpt-oss-20b
HF_TOKEN=

# Model routing. Gemini is preferred; Groq is the immediate fallback if Gemini is unavailable.
GEMINI_LEADER_MODEL=gemini-3.5-flash-lite
GEMINI_WORKER_MODEL=gemini-3.1-flash-lite

# Optional extra models to include in the local leader benchmark (comma-separated IDs).
# Catalogue discovery also tries to retrieve models automatically from each provider.
AI_HOUSE_HF_MODELS=
AI_HOUSE_NVIDIA_MODELS=
AI_HOUSE_TOKEN_HARBOR_MODELS=
AI_HOUSE_GROQ_MODELS=
# Optional local Ollama host (default http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional local-engine settings
# AI_HOUSE_MAX_ITERATIONS=5
# AI_HOUSE_POLL_SECONDS=30
# AI_HOUSE_WORKSPACE=../workspace
# HF_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Gumroad + YouTube integrations (keep actual values in worker/.env only)
GUMROAD_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
# Pexels stock footage for original YouTube production
PEXELS_API_KEY=
# Exa is already supported as a Tavily research fallback
EXA_API_KEY=
