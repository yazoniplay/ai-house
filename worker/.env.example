# Local-only secrets. Copy to worker/.env; never commit real values.
SUPABASE_URL=https://ccdykioxztegxonuyvwb.supabase.co
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
TOKEN_HARBOR_KEY=
TOKEN_HARBOR_MODEL=deepseek-v4.1-flash:free
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3.1-pro
OLLAMA_API_KEY=
# Tavily is required for fresh search when Gemini is unavailable.
TAVILY_API_KEY=
GROQ_API_KEY=
# Main model: CEO and specialist fallback reasoning.
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: task summaries and quick review triage.
GROQ_FAST_MODEL=openai/gpt-oss-20b
HF_TOKEN=

# Additional OpenAI-compatible providers. Gateway/provider usage may be billable.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=openai/gpt-oss-120b
ZAI_API_KEY=
# For a Z.ai Coding Plan key, set ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3-flash
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Model routing. Gemini is preferred; Groq is the immediate fallback if Gemini is unavailable.
GEMINI_LEADER_MODEL=gemini-3.5-flash-lite
GEMINI_WORKER_MODEL=gemini-3.1-flash-lite

# Provider failover: exhausted/rate-limited providers are cooled down and skipped while others continue.
# Defaults: quota 15m, billing/credits 24h, auth/config 1h, timeout 1m, server errors 90s.
AI_HOUSE_QUOTA_COOLDOWN_SECONDS=900
AI_HOUSE_BILLING_COOLDOWN_SECONDS=86400
AI_HOUSE_CONFIG_COOLDOWN_SECONDS=3600
AI_HOUSE_TIMEOUT_COOLDOWN_SECONDS=60
AI_HOUSE_ERROR_COOLDOWN_SECONDS=90

# Optional comma-separated model pools. The worker rotates through these IDs between calls;
# each configured primary model is included automatically. Use provider-supported model IDs.
AI_HOUSE_GEMINI_LEADER_MODELS=
AI_HOUSE_GEMINI_WORKER_MODELS=
AI_HOUSE_GROQ_MODELS=
AI_HOUSE_GROQ_FAST_MODELS=
AI_HOUSE_HF_MODELS=
AI_HOUSE_NVIDIA_MODELS=
AI_HOUSE_TOKEN_HARBOR_MODELS=
AI_HOUSE_OPENROUTER_MODELS=
AI_HOUSE_SAMBANOVA_MODELS=
AI_HOUSE_VERCEL_MODELS=
AI_HOUSE_ZAI_MODELS=
AI_HOUSE_SILICONFLOW_MODELS=
AI_HOUSE_OLLAMA_MODELS=
AI_HOUSE_VERCEL_MAX_MODEL_ATTEMPTS=40
AI_HOUSE_ZAI_MAX_MODEL_ATTEMPTS=40
AI_HOUSE_SILICONFLOW_MAX_MODEL_ATTEMPTS=40
# Optional local Ollama host (default http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional local-engine settings
# AI_HOUSE_MAX_ITERATIONS=5
# AI_HOUSE_POLL_SECONDS=30
# AI_HOUSE_WORKSPACE=../workspace
# HF_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Gumroad + YouTube integrations (keep actual values in worker/.env only)
GUMROAD_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
# Pexels stock footage for original YouTube production
PEXELS_API_KEY=
# Exa is already supported as a Tavily research fallback
EXA_API_KEY=

